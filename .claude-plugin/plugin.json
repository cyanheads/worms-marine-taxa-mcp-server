{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "worms-marine-taxa-mcp-server",
  "version": "0.1.1",
  "description": "Resolve WoRMS marine species names; fetch classifications, synonyms, distributions, traits, and IDs via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/worms-marine-taxa-mcp-server#readme",
  "repository": "https://github.com/cyanheads/worms-marine-taxa-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "ai-agents", "ai-tools", "typescript", "bun", "stdio", "streamable-http", "cyanheads", "worms", "world-register-of-marine-species", "marine-biology", "marine-species", "taxonomy", "aphia", "biodiversity"],
  "mcpServers": {
    "worms-marine-taxa-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/worms-marine-taxa-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
